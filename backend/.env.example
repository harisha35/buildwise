BUILDWISE_ENVIRONMENT=development
BUILDWISE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/buildwise
BUILDWISE_SECRET_KEY=change-me-in-production
BUILDWISE_ACCESS_TOKEN_EXPIRE_MINUTES=30
BUILDWISE_REFRESH_TOKEN_EXPIRE_DAYS=7
BUILDWISE_STORAGE_DIR=./storage_data
BUILDWISE_TIMEZONE=Asia/Kolkata
BUILDWISE_CORS_ORIGINS=["http://localhost:3000"]
BUILDWISE_FRONTEND_BASE_URL=http://localhost:3000

# Optional: leave BUILDWISE_SMTP_HOST unset to log reset emails instead of sending them (local dev)
BUILDWISE_SMTP_HOST=
BUILDWISE_SMTP_PORT=587
BUILDWISE_SMTP_USER=
BUILDWISE_SMTP_PASSWORD=
BUILDWISE_SMTP_FROM=no-reply@buildwise.local
BUILDWISE_SMTP_USE_TLS=true
